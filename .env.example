# Copia de ejemplo. Copie este archivo como `.env` y complete los valores.
# `.env` nunca se versiona (ver `.gitignore`).

# Llave del agente de IA en OpenRouter. Sin llave, la app funciona y muestra
# "no indicado" en el análisis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Clave de las sesiones de Flask. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Acceso a la app: credencial de entorno OPCIONAL, con prioridad cuando se
# define. Si falta alguna de las dos variables, se usa la credencial de
# respaldo de la app y el ingreso sigue funcionando. No se escribe ninguna
# contraseña en este archivo ni en el código.
APP_USUARIO=
APP_CLAVE=

# Ruta al Excel de movimientos para las pruebas (opcional, no se versiona).
# CONCILIADOR_INSUMO=C:\ruta\a\MOVIMIENTOS.xlsx
