# Copia de ejemplo. Copie este archivo como `.env` y complete los valores.
# `.env` nunca se versiona (ver `.gitignore`).

# Llave del agente de IA en OpenRouter. Sin llave, la app funciona y muestra
# "no indicado" en el análisis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Clave de las sesiones de Flask. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Acceso a la app: un solo usuario (un email) y su contraseña. Si alguna de las
# dos queda vacía, no se puede entrar y el formulario avisa «El acceso no está
# configurado en el servidor.». No se escribe la contraseña en el código.
APP_USUARIO=
APP_CLAVE=

# Ruta al Excel de movimientos para las pruebas (opcional, no se versiona).
# CONCILIADOR_INSUMO=C:\ruta\a\MOVIMIENTOS.xlsx
